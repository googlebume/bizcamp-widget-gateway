# Shared Convex backend lives in ../react-widget-bizcamp/convex
# Copy URLs from that project's .env.local after `bun run dev:convex` there.

CONVEX_DEPLOYMENT=

VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Same deployment — used by the live widget demo iframe
VITE_WIDGET_CONVEX_URL=
VITE_WIDGET_CONVEX_SITE_URL=

# Optional absolute URL for the embed snippet in admin.
# Defaults to `{current-origin}/widget.js` (served from this app's public/).
# VITE_WIDGET_SCRIPT_URL=https://your-gateway.example/widget.js

