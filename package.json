{
  "name": "bizcamp-widget-gateway",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run sync-widget && vite --host 0.0.0.0",
    "dev:with-backend": "concurrently --kill-others --names web,convex --prefix-colors cyan,green \"bun run dev\" \"bun run --cwd ../react-widget-bizcamp dev:convex\"",
    "ensure-widget": "bun run scripts/ensure-widget.mjs",
    "sync-widget": "bun run scripts/sync-widget-artifact.mjs",
    "convex:codegen": "cd ../react-widget-bizcamp && convex codegen --typecheck disable",
    "convex:deploy": "cd ../react-widget-bizcamp && convex deploy",
    "build": "bun run sync-widget && bun run convex:codegen && vite build",
    "build:vite": "bun run sync-widget && bun run convex:deploy && vite build",
    "vercel-build": "bun run ensure-widget && (cd ../react-widget-bizcamp && CONVEX_TMPDIR=. convex deploy) && bun run sync-widget && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview"
  },
  "dependencies": {
    "@auth/core": "0.41.1",
    "@convex-dev/auth": "^0.0.94",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.42.3",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.542.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.62.0",
    "react-router-dom": "^7.8.2",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3"
  }
}
